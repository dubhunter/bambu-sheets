{
  "name": "bambu-sheets",
  "version": "1.0.0",
  "description": "Live Bambu Lab filament catalog in Google Sheets — prices, stock, and color variants via the Shopify API",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/google-apps-script": "^2.0.7",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "scripts": {
    "clean": "rm -rf build && rm -rf dist",
    "manifest": "cp appsscript.json dist/",
    "manifest:watch": "chokidar --initial appsscript.json -c \"cp {path} dist/\"",
    "build": "tsc && npm run manifest",
    "build:watch": "tsc --watch",
    "deploy": "clasp push -f",
    "deploy:watch": "clasp push -f --watch",
    "watch": "npx concurrently \"npm:manifest:watch\" \"npm:build:watch\" \"npm:deploy:watch\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  }
}
