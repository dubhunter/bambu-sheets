{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "none",
    "target": "es2021",
    "useDefineForClassFields": true,
    "types": ["@types/google-apps-script"],
    "sourceMap": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
